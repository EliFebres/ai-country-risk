# ──────────────────────────────────────────────────────────────────────────────
# How to use
# 1) Copy this file to `.env` (e.g., backend/.env).
# 2) Fill in the blanks.
# ──────────────────────────────────────────────────────────────────────────────

# === PostgreSQL (Neon) ========================================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=''

# === OpenAI ===================================================================
# Key usually starts with "sk-". Do NOT expose via NEXT_PUBLIC_*.
OPENAI_API_KEY=''

# === Guardian Content API =====================================================
# Free developer key: https://open-platform.theguardian.com/access/
# Used ONLY by the History Machine's article harvest
# (python -m backend.utils.history.run guardian). The daily ETL never reads it,
# so a missing key costs nothing until you backfill.
GUARDIAN_API_KEY=''

# === New York Times Archive API ===============================================
# Free key: https://developer.nytimes.com/ — create an app and enable "Archive
# API". Used ONLY by the History Machine's article harvest
# (python -m backend.utils.history.run nyt). One call returns a whole month of
# the paper, so ten years is ~120 calls; the tier allows 5/minute, 500/day.
# The daily ETL never reads it.
NYT_API_KEY=''

# === Crawlbase ================================================================
# Server-side token for Crawlbase REST API (advanced scraper).
CRAWLBASE_TOKEN=''

# Optional: client-side token for the Crawlbase JS snippet
CRAWLBASE_JS_TOKEN=''

# === FMP (Financial Modeling Prep) ============================================
# API key for the economic-calendar feed (Econ Calendar pane) AND the live
# Prices feed (utils/prices.py: batch-quote, historical-price-eod, and
# treasury-rates endpoints). Plan must include those endpoints. The Prices
# tick reuses this key and DATABASE_URL above — no other secret is needed.
FMP_API_KEY=''
