# ──────────────────────────────────────────────────────────────────────────────
# How to use
# 1) Copy this file to `.env` (e.g., backend/.env).
# 2) Fill in the blanks.
# ──────────────────────────────────────────────────────────────────────────────

# === PostgreSQL (Neon) ========================================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=''

# === OpenAI ===================================================================
# Key usually starts with "sk-". Do NOT expose via NEXT_PUBLIC_*.
OPENAI_API_KEY=''

# === Guardian Content API =====================================================
# Free developer key: https://open-platform.theguardian.com/access/
# Used ONLY by the History Machine's article harvest
# (python -m backend.utils.history.run guardian). The daily ETL never reads it,
# so a missing key costs nothing until you backfill.
GUARDIAN_API_KEY=''

# === New York Times Archive API ===============================================
# Free key: https://developer.nytimes.com/ — create an app and enable "Archive
# API". Used ONLY by the History Machine's article harvest
# (python -m backend.utils.history.run nyt). One call returns a whole month of
# the paper, so ten years is ~120 calls; the tier allows 5/minute, 500/day.
# The daily ETL never reads it.
NYT_API_KEY=''

# === Crawlbase ================================================================
# Server-side token for Crawlbase REST API (advanced scraper).
CRAWLBASE_TOKEN=''

# Optional: client-side token for the Crawlbase JS snippet
CRAWLBASE_JS_TOKEN=''

# === FMP (Financial Modeling Prep) ============================================
# API key for the economic-calendar feed (Econ Calendar pane) AND the live
# Prices feed (utils/prices.py: batch-quote, historical-price-eod, and
# treasury-rates endpoints). Plan must include those endpoints. The Prices
# tick reuses this key and DATABASE_URL above — no other secret is needed.
FMP_API_KEY=''

# === Scorer bake-off (all optional; unset = today's OpenAI configuration) =====
# Two endpoints, one per stage, each with its own model / base URL / key / body.
# Every variable falls back to the literal in `backend/llm/client.py`, so an
# unset environment is byte-identical to the daily run and none of this affects
# `main.py`. Used by `python -m backend.util.tools.bakeoff`.
#
# The stage-1 triple moves the *article digest only*. The body rewrite, the
# digest sweep, the identifiability probe and the Wayback leakage scan stay
# pinned to gpt-4o-mini whatever is set here — they are the masking instrument,
# not a line item, and moving them changes what the pilot measures.
#
# SCORING_EXTRA_BODY / DIGEST_EXTRA_BODY are a JSON object of provider-specific
# request fields. DeepSeek V4 defaults to thinking mode and bills reasoning
# tokens as output, so it needs the pin below or the cost comparison is fiction.
# Malformed JSON raises at client-build time rather than being dropped.
#
# SCORING_MODEL='MiniMax-M3'
# SCORING_BASE_URL='https://api.minimax.io/v1'
# SCORING_API_KEY=''
#
# SCORING_MODEL='deepseek-v4-pro'
# SCORING_BASE_URL='https://api.deepseek.com/v1'
# SCORING_API_KEY=''
# SCORING_EXTRA_BODY='{"thinking": {"type": "disabled"}}'
#
# DIGEST_MODEL='openai/gpt-oss-120b'
# DIGEST_BASE_URL='https://api.groq.com/openai/v1'
# DIGEST_API_KEY=''

# Keys the bake-off reads to fill the triples above, one per vendor, so a run
# can sweep several candidates in one process without rewriting this file.
MINIMAX_API_KEY=''
DEEPSEEK_API_KEY=''
GROQ_API_KEY=''
